# ── Data ──────────────────────────────────────────────
# Package datasets live in data/*.rda (built by data-raw/ scripts) and ARE
# tracked. Raw USDA downloads go in data-raw/raw/ and are not.
data-raw/raw/
*.parquet
*.rds
*.RData
*.feather
*.arrow
*.fst
*.dta
*.sas7bdat
*.sav

# ── Outputs (regenerated by scripts) ─────────────────────
output/
figures/*
!figures/.gitkeep
# !figures/main_figure.png
tables/*
!tables/.gitkeep
# !tables/main_table.csv

# ── R ─────────────────────────────────────────────────
.Rhistory
.RData
.RDataTmp
.Rproj.user/
.Ruserdata
*.Rout
.Rapp.history
# .Rproj is tracked on purpose so a fresh copy opens with the right settings

# R Markdown / Quarto build intermediates
*_cache/
*_files/
*.knit.md
*.utf8.md
.quarto/

# OAuth tokens or credentials (never commit these!)
.httr-oauth
.Renviron
.env
.env.local

# Package development temporary files
/*-Ex.R
/*.tar.gz
/*.Rcheck/
src/*.o
src/*.so
src/*.dll
src/symbols.rds
revdep/
docs/
inst/doc/

# ── LaTeX ─────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb
*_minted-*/

# ── OS junk ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────
.vscode/
*.code-workspace
*.swp
*~

# ── Archive ───────────────────────────────────────────
archive/

/.quarto/
**/*.quarto_ipynb

# PRF outlook release artifacts (rebuilt by data-raw/scripts/prf-outlook/)
data-raw/releases/
